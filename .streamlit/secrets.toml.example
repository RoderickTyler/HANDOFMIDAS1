# Local template only. For real use, copy to .streamlit/secrets.toml (git-ignored)
# for local Streamlit runs, OR paste this into Streamlit Community Cloud's
# "Settings -> Secrets" box when deployed (that's where the real value should live
# in production -- never commit actual keys to the repo).

FRED_API_KEY = "your_key_here"

# Note: the XAUUSD spot quote uses gold-api.com, which needs no key at all.
